# Copia para .env e ajusta. O .env nunca é versionado.

# --- Persistência ---------------------------------------------------------
BRAUNPRICES_DATABASE_URL=postgresql+psycopg://braunprices:braunprices@localhost:5432/braunprices

# --- Identificação na recolha (secção "Ética e âmbito da recolha") ---------
# O user-agent é próprio e identificável, com URL de contacto. Nunca se disfarça
# de browser para contornar bloqueios.
BRAUNPRICES_USER_AGENT=BraunPricesBot/0.1 (+https://github.com/diegobraun/braunprices)
BRAUNPRICES_CONTACT_EMAIL=

# --- Política de recolha --------------------------------------------------
# Limite conservador por domínio. Valores altos não são um ganho de desempenho:
# são um risco de parecer um ataque a uma loja.
BRAUNPRICES_REQUESTS_PER_SECOND=0.5
BRAUNPRICES_MAX_CONCURRENCY_PER_DOMAIN=1
BRAUNPRICES_REQUEST_TIMEOUT_SECONDS=20

# --- Operação -------------------------------------------------------------
BRAUNPRICES_LOG_LEVEL=INFO
BRAUNPRICES_TIMEZONE=Europe/Lisbon
